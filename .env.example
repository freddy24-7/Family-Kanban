# Copy to .env and fill in. This file is the contract for all configuration.

APP_ENV=development

# Database (local docker-compose default). Tests use TEST_DATABASE_URL
# (default: the famkanban_test database on the same server).
DATABASE_URL=postgresql+psycopg://famkanban:famkanban@localhost:5433/famkanban

# Auth (fastapi-users) — Phase 1
# >= 32 chars; generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=
ACCESS_TOKEN_LIFETIME_SECONDS=2592000
INVITE_LIFETIME_DAYS=7
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Email (Resend) — inert when empty; links are logged instead — Phase 1
RESEND_API_KEY=
EMAIL_FROM=

# LLM (Gemini) — inert when empty — Phase 2
GEMINI_API_KEY=

# Links in emails and Google OAuth redirects point here; also the default CORS origin
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Predictions below this confidence are flagged for review (tuned in Phase 3)
LOW_CONFIDENCE_THRESHOLD=0.6

# Model artifacts directory (Railway volume in production)
MODEL_ARTIFACT_DIR=../data/artifacts

# Frontend
VITE_API_URL=http://localhost:8000
