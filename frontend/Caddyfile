{
	admin off
	auto_https off
}

# Railway injects PORT; TLS is terminated by Railway's edge.
:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Hashed build assets never change: cache forever.
	@immutable path /assets/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# Everything else (index.html for every SPA route, the service worker, the
	# manifest) must be revalidated, or phones keep an old version after a deploy.
	@revalidate not path /assets/*
	header @revalidate Cache-Control "no-cache"

	# SPA fallback: /board, /invite?token=... etc. all load index.html.
	try_files {path} /index.html
	file_server
}
